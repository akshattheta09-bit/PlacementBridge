{
  "name": "placementbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "lint": "next lint",
    "test:smoke": "node --env-file=.env tests/smoke/announcements.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "3.0.3",
    "next": "15.5.12",
    "next-auth": "5.0.0-beta.30",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "1.2.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.12",
    "prisma": "6.19.2",
    "tailwindcss": "4.1.18",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
